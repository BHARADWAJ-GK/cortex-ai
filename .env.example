# ═══════════════════════════════════════════════════
#  CORTEX AI — Environment Variables
#  Copy this file to .env.local and fill in values
# ═══════════════════════════════════════════════════

# ── Database (PostgreSQL) ──────────────────────────
# Local:   postgresql://USER:PASSWORD@localhost:5432/cortexai
# Railway: Get from your Railway project dashboard
# Supabase: Get from Project Settings > Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/cortexai"

# ── NextAuth.js ────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# ── Anthropic AI API ───────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── App Config ────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Cortex AI"

# ── Optional: GitHub OAuth ─────────────────────────
# Create at: https://github.com/settings/apps
GITHUB_ID=""
GITHUB_SECRET=""

# ── Optional: Google OAuth ─────────────────────────
# Create at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
